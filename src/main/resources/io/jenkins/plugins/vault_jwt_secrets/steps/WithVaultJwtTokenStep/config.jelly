<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="Environment variable" field="variable">
    <f:textbox default="VAULT_ID_TOKEN" />
  </f:entry>
  <f:entry title="Audience" field="audience">
    <f:textbox />
  </f:entry>
  <f:advanced>
    <f:entry title="Vault URL override" field="vaultUrl">
      <f:textbox />
    </f:entry>
    <f:entry title="Explicit id token credentials ID" field="idTokenCredentialsId">
      <f:textbox />
    </f:entry>
  </f:advanced>
</j:jelly>
