<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:st="jelly:stapler">
  <st:include page="id-and-description" class="${descriptor.clazz}" />
  <f:entry title="Vault path" field="path">
    <f:textbox placeholder="production/db@ops" />
  </f:entry>
  <f:entry title="Field" field="field">
    <f:textbox placeholder="password" />
  </f:entry>
  <f:entry title="Vault role" field="role">
    <f:textbox />
  </f:entry>
  <f:advanced>
    <f:entry title="Vault URL override" field="vaultUrl">
      <f:textbox />
    </f:entry>
    <f:entry title="JWT auth path override" field="authPath">
      <f:textbox />
    </f:entry>
    <f:entry title="Vault namespace override" field="namespace">
      <f:textbox />
    </f:entry>
    <f:entry title="Audience override" field="audience">
      <f:textbox />
    </f:entry>
  </f:advanced>
</j:jelly>
